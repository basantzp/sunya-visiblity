{
  "name": "sunya-visiblity",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous Local Website & Lead-Generation Agency for Kathmandu Valley",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "next start --port 3005",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pipeline:all": "tsx scripts/run-pipeline.ts --action all",
    "pipeline:discover": "tsx scripts/run-pipeline.ts --action discover",
    "pipeline:enrich": "tsx scripts/run-pipeline.ts --action enrich",
    "pipeline:generate": "tsx scripts/run-pipeline.ts --action generate",
    "pipeline:outreach": "tsx scripts/run-pipeline.ts --action outreach",
    "test:shandar": "tsx scripts/test-shandar-momo.ts",
    "version:list": "tsx scripts/version-manager.ts list",
    "version:snapshot": "tsx scripts/version-manager.ts snapshot",
    "version:downgrade": "tsx scripts/version-manager.ts downgrade",
    "version:upgrade": "tsx scripts/version-manager.ts upgrade",
    "snapshot": "tsx scripts/version-manager.ts snapshot",
    "downgrade": "tsx scripts/version-manager.ts downgrade",
    "upgrade": "tsx scripts/version-manager.ts upgrade",
    "worker": "tsx scripts/cron-worker.ts",
    "clean": "rm -rf .next dist build coverage *.tsbuildinfo",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.16.0",
    "next": "^15.1.7",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
