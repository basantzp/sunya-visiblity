# ==============================================================================
# Sunya Visibility — Environment Variables
# ==============================================================================

# 1. Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3005

# 2. Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Google APIs
# Required for Places API (Kathmandu Valley Discovery)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Required for AI Copywriting & Review Theme Synthesis
GEMINI_API_KEY=your-gemini-api-key

# 4. Email Dispatch (Gmail SMTP - reused from AutoApply AI)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# 5. WhatsApp Dispatch (Meta WhatsApp Cloud API or Twilio)
WHATSAPP_CLOUD_TOKEN=your-whatsapp-cloud-api-bearer-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# 6. Preview Deployment (Vercel API)
VERCEL_API_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=your-vercel-project-id

# 7. Founder Contact & Merchant Details
FOUNDER_NAME=Basant
FOUNDER_WHATSAPP=+977-9800000000
ESEWA_MERCHANT_ID=9800000000
KHALTI_MERCHANT_ID=9800000000
