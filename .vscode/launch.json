{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Node (Server-side)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Pipeline CLI (All)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "scripts/run-pipeline.ts", "--action", "all"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Pipeline CLI (Discover)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "scripts/run-pipeline.ts", "--action", "discover"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Current Vitest File",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "smartStep": true,
      "console": "integratedTerminal"
    }
  ]
}
